{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skirr",
  "version": "0.1.0",
  "identifier": "io.github.klangche.skirr",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skirr — USB Diagnostics",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": ["icons/skirr_icon.png", "icons/icon.ico"]
  }
}
